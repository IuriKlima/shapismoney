# Public metadata only. Fill after HTTPS/proxy/container review; no secrets here.
NODE_ENV=production
SIM_BACKEND_PORT=5190
SIM_PRODUCTION_REVIEWED=false
SIM_DEPLOYMENT_STAGE=production
# Staging requires exact reviewer IPs; never a CIDR or wildcard.
SIM_STAGING_CLIENT_IPS=
SIM_PUBLIC_ORIGIN=
SIM_TRUSTED_PROXY_IPS=
SIM_PROXY_NETWORK=
PGHOST=shape-is-money-db
PGPORT=5432
PGDATABASE=sim_platform
PGUSER=sim_app
SIM_DB_TLS=private-network
SIM_DB_BOOTSTRAP_SECRET_FILE=
SIM_DB_MIGRATOR_SECRET_FILE=
SIM_DB_APP_SECRET_FILE=
SIM_AI_ENABLED=false
SIM_ACCESS_EMAIL_ENABLED=false
SIM_ACCESS_EMAIL_REVIEWED=false
# Candidate transport only; keep disabled until provider/sender/security review.
SIM_MAIL_PROVIDER=smtp
SIM_MAIL_FROM=
SIM_MAIL_API_KEY_FILE=
SIM_SMTP_HOST=
SIM_SMTP_PORT=465
SIM_SMTP_USER=
SIM_SMTP_PASSWORD_FILE=
OPENAI_MODEL=gpt-5.4-nano
# Supply DB and optional OpenAI secrets only through approved server secret storage.

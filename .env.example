# Optional local-only media catalog. Absolute path to the folder containing
# indice-videos.csv and the original MP4 files. Keep media outside this repo.
SIM_VIDEO_DIR=
# Loopback media/standalone preview port. Default matches the integrated UI.
SIM_MEDIA_PORT=5174
# OPENAI_API_KEY, if configured later, belongs in ignored .env.local on server.
# There is no AI integration or API request in this demonstration.

# Optional server-only model for dev:ai. Never use a VITE_ prefix for credentials.
OPENAI_MODEL=gpt-5.4-nano

# Authenticated local AI is disabled unless explicitly enabled.
SIM_AI_ENABLED=false
